# No folder ever lists its files. A folder without an index page answers 403.
Options -Indexes

# ------------------------------------------------------------------ HTTPS only
#
# Cloudflare also accepts plain http://edutrack.art and passes it through the
# tunnel, so passwords would cross the internet unencrypted. Those visitors are
# sent to https:// instead, and HSTS tells the browser never to try http again.
# <If> applies to every folder below this one, including the ones with their
# own RewriteEngine. Requests on this machine (no CF-Connecting-IP) are left
# alone, so http://localhost keeps working.
<If "-n req('CF-Connecting-IP') && req('X-Forwarded-Proto') == 'http'">
    Redirect 301 "https://%{HTTP_HOST}%{REQUEST_URI}"
</If>
<IfModule mod_headers.c>
    <If "-n req('CF-Connecting-IP') && req('X-Forwarded-Proto') == 'https'">
        Header always set Strict-Transport-Security "max-age=31536000"
    </If>
    # Names the exact PHP version, which only helps someone pick an exploit.
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>

# Pages are always checked for a newer version before a cached copy is used.
# Without this, browsers and the Android app's WebView guess how long to keep
# a page, and keep showing an old one after the site changes. An unchanged
# page still loads from cache after a quick 304, so this costs next to nothing.
# Scripts and stylesheets are versioned in their URLs (?v=) instead.
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# ---------------------------------------------------------------- page policy
#
# The pages load type from Google Fonts and the 360 viewer from jsDelivr, and
# they carry their own inline <script> blocks. Everything else is refused, so a
# string that escaped an escaper still has nowhere to send anything and no
# third-party file it can pull in. frame-ancestors stops the panel being framed
# and clicked through from another site.
#
# The developer machine is exempt: the design tooling injects a script from
# http://localhost:8400, which a policy this tight would block. Every other
# caller gets the policy.
<IfModule mod_setenvif.c>
    SetEnvIf Remote_Addr "^(127\.0\.0\.1|::1)$" edutrack_local=1
    # Public visitors arrive through the Cloudflare tunnel, which connects from
    # loopback too. Cloudflare always adds this header, so its presence means
    # the request is not from the developer machine.
    SetEnvIf CF-Connecting-IP "." !edutrack_local
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'" env=!edutrack_local
        Header always set X-Frame-Options "DENY"
        Header always set X-Content-Type-Options "nosniff"
        Header always set Referrer-Policy "same-origin"
    </FilesMatch>
</IfModule>

# ------------------------------------------------------------ closed to HTTP
#
# config.php holds the database password. PHP normally executes it rather than
# printing it, but that is only true while PHP is working: a mis-set handler or
# a half-finished upgrade serves it as plain text. Nothing fetches it over HTTP,
# so refusing it outright costs nothing.
# Backup and editor copies too: config.php.bak is not run by PHP, so Apache
# would hand the passwords in it out as plain text.
<FilesMatch "^(config\.php.*|config\.example\.php|composer\.(json|lock)|\.env.*|.*\.sql|.*\.md|.*\.(bak|old|orig|save|swp|tmp|log)|.*~)$">
    Require all denied
</FilesMatch>

# Map snapshots and the photos staff replaced are kept here. PHP reads them
# from disk; they were never meant to be browsable.
RedirectMatch 404 ^/EduTrack/(storage|sql|tools|vendor)/

# Repository and tooling files. The public site is served straight out of this
# checkout, so without this /.git/ hands out the full source and history.
# Only refused through the tunnel: the design tooling on this machine reads
# .impeccable over localhost.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:CF-Connecting-IP} .
    RewriteRule ^(\.|mobile_app/|node_modules/|EduTrack$|START-ONLINE\.bat$|package(-lock)?\.json$) - [R=404,L]
</IfModule>
