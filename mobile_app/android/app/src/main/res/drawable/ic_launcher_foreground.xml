<?xml version="1.0" encoding="utf-8"?>
<!--
  EduTrack launcher icon, front layer (adaptive icon, Android 8 and later).
  "ET" for EduTrack in bold white on the school's blue, with a white and red
  rule underneath: the two-colour rule that sits under the site's page title,
  in the school's colours. The blue behind it is ic_launcher_background.

  E and T are all straight strokes, so they are drawn as bars, sharp at any
  size. Drawn in the 108-unit adaptive grid; everything sits inside the
  66-unit safe circle, so no launcher shape cuts into it. The legacy PNGs in
  the mipmap folders are the same drawing.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- E: the upright and its three arms -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M33,35h7v30h-7zM33,35h17v7h-17zM33,46.5h14v7h-14zM33,58h17v7h-17z" />
    <!-- T: the crossbar and the stem -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,35h21v7h-21zM61,35h7v30h-7z" />
    <!-- the rule: white, then red -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M33,69h21v4h-21z" />
    <path
        android:fillColor="#D3112A"
        android:pathData="M54,69h21v4h-21z" />
</vector>
